# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.uv-cache/
.uv-python/

# Local settings and secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
credentials*.json
service-account*.json
kaggle.json
.kaggle/
.streamlit/secrets.toml
secrets.*

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Source data may contain personal information and is never committed.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Generated datasets, predictions, models, plots, and reports.
data/processed/*
!data/processed/.gitkeep
data/labels/*
!data/labels/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Downloaded models and large generated binary files
models/
.cache/huggingface/
.huggingface/
*.bin
*.joblib
*.npy
*.npz
*.onnx
*.pickle
*.pkl
*.pt
*.pth
